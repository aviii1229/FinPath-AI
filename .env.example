# ==============================================================================
# FinPath AI — Environment Configuration Template
# Copy this file to .env before starting Docker Compose: cp .env.example .env
# ==============================================================================

# Database Settings (PostgreSQL + pgvector)
POSTGRES_DB=finpath_db
POSTGRES_USER=finpath_user
POSTGRES_PASSWORD=finpath_secret_change_in_production
POSTGRES_PORT=5432

# Spring Boot Backend Settings
SPRING_PROFILES_ACTIVE=docker
SPRING_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Provider-Independent AI Gateway Keys (Optional - System uses deterministic fallbacks if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Frontend SPA
FRONTEND_PORT=80
VITE_API_BASE_URL=/api/v1

